{
  "name": "loan-verification-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for commercial loan document verification, KYC, fraud detection, and GST intelligence",
  "main": "dist/index.js",
  "scripts": {
    "build": "chmod +x node_modules/.bin/tsc && tsc",
    "start": "node dist/index.js",
    "start:http": "cross-env TRANSPORT=http USE_MOCK_APIS=true node dist/index.js",
    "start:http:prod": "cross-env TRANSPORT=http USE_MOCK_APIS=false node dist/index.js",
    "dev": "cross-env TRANSPORT=http USE_MOCK_APIS=true ts-node src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "axios": "^1.7.2",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2"
  }
}